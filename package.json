{
  "name": "pocket-accountant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=.env src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file=.env dist/server/index.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
